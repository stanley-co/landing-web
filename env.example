# Конфигурация Bitrix24 интеграции
#
# ЛОКАЛЬНАЯ РАЗРАБОТКА:
# 1. Скопируйте этот файл в .env.local
# 2. Заполните реальными значениями
# 3. Перезапустите dev-сервер
#
# PRODUCTION (ДЕПЛОЙ):
# Настройте переменные в GitHub Secrets:
# Settings → Secrets and variables → Actions → New repository secret
# Добавьте: VITE_BITRIX_WEBHOOK_URL, VITE_BITRIX_DEMO_MODE, VITE_FORM_DISABLED

# URL вебхука Bitrix24 для создания лидов
# Получите: Bitrix24 → Приложения → Входящий вебхук → Создать вебхук с правами "CRM: Лиды"
VITE_BITRIX_WEBHOOK_URL=https://your-domain.bitrix24.ru/rest/1/your_webhook_key/crm.lead.add.json

# Демонстрационный режим (true = не отправляет запросы, false = отправляет)
VITE_BITRIX_DEMO_MODE=true

# Отключение формы (true = форма скрыта, false = форма видна)
VITE_FORM_DISABLED=false

