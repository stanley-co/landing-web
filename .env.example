# Базовый URL сайта для canonical и Open Graph (без завершающего слэша).
# Пример: https://example.com
# В production обязательно задайте при сборке.
VITE_SITE_URL=https://example.com

# Опционально: бакет S3 для статических данных (по умолчанию stanley-co)
# VITE_S3_BUCKET=stanley-co

# Exact Admin origin permitted to send transient preview drafts.
VITE_ADMIN_PREVIEW_ORIGIN=http://localhost:5173
